@model RezervasyonSistemi.Models.ViewModels.PersonelCreateViewModel

@{
    ViewData["Title"] = "Yeni Personel ve Kullanıcı Hesabı Ekle";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-6">
        <div class="card shadow border-0 rounded-3">
            <div class="card-header bg-dark text-white py-3">
                <h5 class="mb-0 fw-bold"><i class="bi bi-person-plus me-2"></i>Yeni Personel ve Kullanıcı Hesabı Ekle</h5>
            </div>
            <div class="card-body p-4">
                <form asp-action="Create" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label asp-for="Ad" class="form-label fw-semibold"></label>
                            <input asp-for="Ad" class="form-control" placeholder="Personel Adı" />
                            <span asp-validation-for="Ad" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Soyad" class="form-label fw-semibold"></label>
                            <input asp-for="Soyad" class="form-control" placeholder="Personel Soyadı" />
                            <span asp-validation-for="Soyad" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Birim" class="form-label fw-semibold"></label>
                        <input asp-for="Birim" class="form-control" placeholder="Örn: İnsan Kaynakları, Bilgi İşlem" />
                        <span asp-validation-for="Birim" class="text-danger"></span>
                    </div>

                    <hr class="my-4" />
                    <h6 class="fw-bold text-primary mb-3"><i class="bi bi-key me-1"></i>Sistem Giriş Hesabı Bilgileri</h6>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label fw-semibold"></label>
                        <input asp-for="Email" class="form-control" placeholder="personel@rezervasyon.com" autocomplete="off" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label fw-semibold"></label>
                        <input asp-for="Password" class="form-control" placeholder="••••••••" autocomplete="new-password" />
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>

                    <div class="d-flex justify-content-between mt-4">
                        <a asp-action="Index" class="btn btn-outline-secondary">Listeye Dön</a>
                        <button type="submit" class="btn btn-success fw-bold px-4">Personel ve Hesabı Oluştur</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
