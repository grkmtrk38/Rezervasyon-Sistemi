@model IEnumerable<RezervasyonSistemi.Models.Personel>

@{
    ViewData["Title"] = "Personel Yönetimi";
}

<div class="card shadow border-0 rounded-3 mt-3">
    <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center py-3">
        <h5 class="mb-0 fw-bold"><i class="bi bi-people me-2"></i>Personel Listesi</h5>
        <a asp-action="Create" class="btn btn-success btn-sm fw-bold shadow-sm">
            <i class="bi bi-plus-lg me-1"></i> Yeni Personel Ekle
        </a>
    </div>
    <div class="card-body p-3">
        @if (!Model.Any())
        {
            <div class="d-flex flex-column align-items-center justify-content-center text-center py-5 my-2">
                <i class="bi bi-person-x display-3 text-secondary opacity-50 mb-2"></i>
                <h5 class="fw-bold mt-2 mb-1">Henüz Personel Kaydı Yok</h5>
                <p class="text-muted small col-md-6 mb-3">Sistemi kullanacak ekip personeli henüz eklenmemiş. Yeni bir personel tanımlayarak başlayabilirsiniz.</p>
                <a asp-action="Create" class="btn btn-success btn-sm px-4 fw-bold shadow-sm">
                    <i class="bi bi-plus-lg me-1"></i> İlk Personeli Ekle
                </a>
            </div>
        }
        else
        {
            <div class="scrollable-table-wrapper" style="max-height: 500px; overflow-y: auto;">
                <table id="personellerTable" class="table table-hover table-striped align-middle mb-0" style="width:100%">
                    <thead>
                        <tr>
                            <th>Personel</th>
                            <th>Soyad</th>
                            <th>Birim / Müdürlük</th>
                            <th class="text-end">İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                @foreach (var item in Model) {
                    var tamAd = $"{item.Ad} {item.Soyad}";
                        <tr>
                            <td class="fw-semibold">
                                <div class="d-flex align-items-center">
                                    <img src="https://ui-avatars.com/api/?name=@(System.Net.WebUtility.UrlEncode(tamAd))&background=random&color=fff&rounded=true&size=32" class="rounded-circle me-2" alt="Avatar" width="32" height="32" />
                                    <span>@item.Ad</span>
                                </div>
                            </td>
                            <td class="fw-semibold">@item.Soyad</td>
                            <td>
                                <span class="badge bg-info-subtle text-info border border-info-subtle rounded-pill px-3 py-1 fw-bold">@item.Birim</span>
                            </td>
                            <td class="text-end">
                                <div class="btn-group btn-group-sm" role="group">
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-primary">Düzenle</a>
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-info">Detay</a>
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-outline-danger">Sil</a>
                                </div>
                            </td>
                        </tr>
                }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#personellerTable').DataTable({
                "language": {
                    "lengthMenu": "Sayfada _MENU_ kayıt göster",
                    "zeroRecords": "<div class='py-3 text-muted'><i class='bi bi-search fs-3 d-block mb-1 opacity-50'></i>Eşleşen kayıt bulunamadı</div>",
                    "info": "_TOTAL_ kayıttan _START_ - _END_ arası gösteriliyor",
                    "infoEmpty": "Kayıt yok",
                    "infoFiltered": "(_MAX_ kayıt içerisinden filtrelendi)",
                    "search": "Ara:",
                    "paginate": {
                        "first": "İlk",
                        "last": "Son",
                        "next": "Sonraki",
                        "previous": "Önceki"
                    }
                },
                "pageLength": 10,
                "responsive": true,
                "order": [[0, "asc"]]
            });
        });
    </script>
}
