@using Microsoft.AspNetCore.Identity
@using RezervasyonSistemi.Models
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TailAdmin Rezervasyon</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <!-- Bootstrap Icons CDN -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <!-- DataTables Bootstrap 5 CSS -->
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.7/css/dataTables.bootstrap5.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/RezervasyonSistemi.styles.css" asp-append-version="true" />
    <!-- Early theme initialization script -->
    <script src="~/js/site.js" asp-append-version="true"></script>
</head>
<body>
    <div id="app-wrapper">
        <!-- Sidebar (Sol Yan Menü) -->
        <aside id="sidebar-wrapper">
            <a class="sidebar-brand" asp-controller="Home" asp-action="Index">
                <i class="bi bi-calendar2-check-fill me-2 fs-4"></i> TailAdmin
            </a>
            <ul class="sidebar-nav">
                <li class="nav-label">Ana Menü</li>
                <li class="nav-item">
                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "active" : "")" asp-controller="Home" asp-action="Index">
                        <i class="bi bi-grid-1x2-fill"></i> Ana Sayfa
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Rezervasyons" && ViewContext.RouteData.Values["action"]?.ToString() == "OnayBekleyenler" ? "active" : "")" asp-controller="Rezervasyons" asp-action="OnayBekleyenler">
                        <i class="bi bi-hourglass-split"></i> Onay Bekleyenler
                    </a>
                </li>
                @if (User.Identity != null && User.Identity.IsAuthenticated)
                {
                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Takvim" ? "active" : "")" asp-controller="Rezervasyons" asp-action="Takvim">
                            <i class="bi bi-calendar3"></i> Takvim
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Rezervasyons" && ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")" asp-controller="Rezervasyons" asp-action="Index">
                            <i class="bi bi-card-checklist"></i> Rezervasyonlar
                        </a>
                    </li>

                    @if (true)
                    {
                        <li class="nav-label mt-4">Yönetim Paneli</li>
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Kaynaks" ? "active" : "")" asp-controller="Kaynaks" asp-action="Index">
                                <i class="bi bi-box-seam-fill"></i> Kaynak Yönetimi
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Personels" ? "active" : "")" asp-controller="Personels" asp-action="Index">
                                <i class="bi bi-people-fill"></i> Personel Yönetimi
                            </a>
                        </li>
                    }
                }
            </ul>
        </aside>

        <!-- Page Content Wrapper -->
        <div id="page-content-wrapper">
            <!-- Topbar (Üst Bar) -->
            <header id="topbar">
                <div class="d-flex align-items-center gap-3">
                    <button id="sidebar-toggle-btn" class="topbar-toggle-btn" title="Menüyü Daralt/Aç">
                        <i class="bi bi-list"></i>
                    </button>
                    <h6 class="mb-0 fw-bold d-none d-md-block text-secondary">Şirket İçi Rezervasyon Platformu</h6>
                </div>

                <div class="topbar-right">
                    <!-- Dark Mode Toggle Button -->
                    <button id="theme-toggle-btn" class="theme-toggle-btn" title="Karanlık/Aydınlık Mod Değiştir">
                        <i id="theme-icon" class="bi bi-moon-stars-fill"></i>
                    </button>

                    <!-- User Profile & Auth Status -->
                    @if (SignInManager.IsSignedIn(User))
                    {
                        var currentUser = await UserManager.GetUserAsync(User);
                        var nameDisplay = currentUser != null ? $"{currentUser.Ad} {currentUser.Soyad}" : (User.Identity?.Name ?? "Kullanıcı");
                        <div class="d-flex align-items-center gap-3 ms-2">
                            <div class="d-flex align-items-center">
                                <img src="https://ui-avatars.com/api/?name=@(System.Net.WebUtility.UrlEncode(nameDisplay))&background=random&color=fff&rounded=true&size=36" class="rounded-circle me-2 shadow-sm" alt="Avatar" width="36" height="36" />
                                <div class="text-start d-none d-sm-block">
                                    <div class="fw-bold small me-1">@nameDisplay</div>
                                    @if (User.IsInRole("Admin"))
                                    {
                                        <span class="badge bg-danger" style="font-size: 0.7rem;">Admin</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary" style="font-size: 0.7rem;">Kullanıcı</span>
                                    }
                                </div>
                            </div>
                            <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                <button type="submit" class="btn btn-outline-danger btn-sm fw-bold">
                                    <i class="bi bi-box-arrow-right me-1"></i> Çıkış
                                </button>
                            </form>
                        </div>
                    }
                    else
                    {
                        <a asp-controller="Account" asp-action="Login" class="btn btn-primary btn-sm px-4 fw-bold">
                            <i class="bi bi-box-arrow-in-right me-1"></i> Giriş Yap
                        </a>
                    }
                </div>
            </header>

            <!-- Main Content Container -->
            <main role="main" class="main-container">
                @RenderBody()
            </main>

            <!-- Footer -->
            <footer class="footer text-muted">
                <div class="d-flex justify-content-between align-items-center">
                    <div>&copy; 2026 - Rezervasyon Sistemi</div>
                    <div>TailAdmin Dashboard Teması</div>
                </div>
            </footer>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <!-- DataTables JS & Bootstrap 5 Integration -->
    <script src="https://cdn.datatables.net/1.13.7/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.7/js/dataTables.bootstrap5.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
