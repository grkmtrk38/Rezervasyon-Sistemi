@model IEnumerable<RezervasyonSistemi.Models.Rezervasyon>
@using Microsoft.AspNetCore.Identity
@inject UserManager<ApplicationUser> UserManager

@{
    ViewData["Title"] = "Rezervasyonlar";
    var currentUser = await UserManager.GetUserAsync(User);
    var currentPersonelId = currentUser?.PersonelId;
    bool isAdmin = User.IsInRole("Admin");
}

<div class="card shadow border-0 rounded-3 mt-3">
    <div class="card-header bg-success text-white d-flex justify-content-between align-items-center py-3">
        <h5 class="mb-0 fw-bold"><i class="bi bi-calendar-check me-2"></i>Rezervasyon Listesi</h5>
        <div>
            <a asp-action="ExportToCsv" class="btn btn-outline-light btn-sm fw-bold me-2 shadow-sm" title="Excel / CSV formatında indir">
                📊 Excel / CSV İndir
            </a>
            <a asp-action="Takvim" class="btn btn-light btn-sm fw-bold me-2 shadow-sm">
                🗓️ Takvim Görünümü
            </a>
            <a asp-action="Create" class="btn btn-warning btn-sm fw-bold shadow-sm text-dark">
                ➕ Yeni Rezervasyon
            </a>
        </div>
    </div>
    <div class="card-body p-3">
        @if (!Model.Any())
        {
            <div class="d-flex flex-column align-items-center justify-content-center text-center py-5 my-2">
                <i class="bi bi-calendar2-x display-3 text-secondary opacity-50 mb-2"></i>
                <h5 class="fw-bold mt-2 mb-1">Henüz Rezervasyon Oluşturulmamış</h5>
                <p class="text-muted small col-md-6 mb-3">Sistemde aktif veya geçmiş bir rezervasyon bulunmuyor. Ekip için ilk alan veya araç rezervasyonunu şimdi yapabilirsiniz.</p>
                <a asp-action="Create" class="btn btn-warning btn-sm px-4 fw-bold text-dark shadow-sm">
                    ➕ Yeni Rezervasyon Oluştur
                </a>
            </div>
        }
        else
        {
            <div class="scrollable-table-wrapper" style="max-height: 500px; overflow-y: auto;">
                <table id="rezervasyonlarTable" class="table table-hover table-striped align-middle mb-0" style="width:100%">
                    <thead>
                        <tr>
                            <th>Personel</th>
                            <th>Kaynak</th>
                            <th>Başlangıç Tarihi</th>
                            <th>Bitiş Tarihi</th>
                            <th>Açıklama</th>
                            <th>Durum</th>
                            <th>Oluşturma Tarihi</th>
                            <th class="text-end">İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                @foreach (var item in Model) {
                    bool isCancelled = item.Durum == "İptal Edildi" || item.Durum == "Iptal";
                    bool isOwnerOrAdmin = isAdmin || (currentPersonelId.HasValue && item.PersonelId == currentPersonelId.Value);
                    string personelTamAd = item.Personel != null ? $"{item.Personel.Ad} {item.Personel.Soyad}" : "Belirtilmedi";

                        <tr class="@(isCancelled ? "table-secondary opacity-75" : item.Durum == "Reddedildi" ? "table-danger opacity-75" : "")">
                            <td class="fw-semibold">
                                <div class="d-flex align-items-center">
                                    <img src="https://ui-avatars.com/api/?name=@(System.Net.WebUtility.UrlEncode(personelTamAd))&background=random&color=fff&rounded=true&size=32" class="rounded-circle me-2" alt="Avatar" width="32" height="32" />
                                    <span>@personelTamAd</span>
                                    @if (currentPersonelId.HasValue && item.PersonelId == currentPersonelId.Value)
                                    {
                                        <span class="badge bg-info-subtle text-info border border-info-subtle rounded-pill px-2 py-1 ms-2">Siz</span>
                                    }
                                </div>
                            </td>
                            <td>
                                <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-3 py-1 fw-bold">@(item.Kaynak != null ? item.Kaynak.Ad : "Belirtilmedi")</span>
                            </td>
                            <td>@item.BaslangicTarihi.ToString("dd.MM.yyyy HH:mm")</td>
                            <td>@item.BitisTarihi.ToString("dd.MM.yyyy HH:mm")</td>
                            <td>
                                <small class="text-muted">@(string.IsNullOrEmpty(item.Aciklama) ? "-" : item.Aciklama)</small>
                            </td>
                            <td>
                                @if (isCancelled)
                                {
                                    <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle rounded-pill px-3 py-1 fw-bold">İptal Edildi</span>
                                }
                                else if (item.Durum == "Reddedildi")
                                {
                                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill px-3 py-1 fw-bold">Reddedildi</span>
                                }
                                else if (item.Durum == "Beklemede")
                                {
                                    <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle rounded-pill px-3 py-1 fw-bold">⏳ Beklemede</span>
                                }
                                else
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-1 fw-bold">✓ Onaylandı</span>
                                }
                            </td>
                            <td>@item.OlusturmaTarihi.ToString("dd.MM.yyyy HH:mm")</td>
                            <td class="text-end">
                                <div class="btn-group btn-group-sm" role="group">
                                    @if (isAdmin && item.Durum == "Beklemede")
                                    {
                                        <form asp-action="Approve" asp-route-id="@item.Id" method="post" class="d-inline">
                                            <button type="submit" class="btn btn-sm btn-success me-1 fw-bold" title="Rezervasyonu Onayla">
                                                ✓ Onayla
                                            </button>
                                        </form>
                                        <form asp-action="Reject" asp-route-id="@item.Id" method="post" class="d-inline me-1">
                                            <button type="submit" class="btn btn-sm btn-danger me-1 fw-bold" title="Rezervasyonu Reddet">
                                                ✕ Reddet
                                            </button>
                                        </form>
                                    }

                                    @if (isOwnerOrAdmin && !isCancelled && item.Durum != "Reddedildi")
                                    {
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-primary">Düzenle</a>
                                    }
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-info">Detay</a>
                                    @if (isCancelled)
                                    {
                                        <button class="btn btn-outline-secondary" disabled>İptal Edildi</button>
                                    }
                                    else if (item.Durum == "Reddedildi")
                                    {
                                        <button class="btn btn-outline-danger" disabled>Reddedildi</button>
                                    }
                                    else if (isOwnerOrAdmin)
                                    {
                                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-outline-danger">İptal Et</a>
                                    }
                                </div>
                            </td>
                        </tr>
                }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#rezervasyonlarTable').DataTable({
                "language": {
                    "lengthMenu": "Sayfada _MENU_ kayıt göster",
                    "zeroRecords": "<div class='py-3 text-muted'><i class='bi bi-search fs-3 d-block mb-1 opacity-50'></i>Eşleşen kayıt bulunamadı</div>",
                    "info": "_TOTAL_ kayıttan _START_ - _END_ arası gösteriliyor",
                    "infoEmpty": "Kayıt yok",
                    "infoFiltered": "(_MAX_ kayıt içerisinden filtrelendi)",
                    "search": "Ara:",
                    "paginate": {
                        "first": "İlk",
                        "last": "Son",
                        "next": "Sonraki",
                        "previous": "Önceki"
                    }
                },
                "pageLength": 10,
                "responsive": true,
                "order": [[2, "desc"]]
            });
        });
    </script>
}
