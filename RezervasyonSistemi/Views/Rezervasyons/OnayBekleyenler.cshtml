@model IEnumerable<RezervasyonSistemi.Models.Rezervasyon>

@{
    ViewData["Title"] = "Onay Bekleyen Rezervasyonlar";
}

<div class="card shadow border-0 rounded-3 mt-3">
    <div class="card-header bg-warning text-dark d-flex justify-content-between align-items-center py-3">
        <h5 class="mb-0 fw-bold"><i class="bi bi-hourglass-split me-2"></i>Onay Bekleyen Rezervasyonlar</h5>
        <div>
            <a asp-action="Index" class="btn btn-outline-dark btn-sm fw-bold">
                <i class="bi bi-arrow-left me-1"></i> Tüm Rezervasyonlar
            </a>
        </div>
    </div>
    <div class="card-body p-3">
        @if (!Model.Any())
        {
            <div class="d-flex flex-column align-items-center justify-content-center text-center py-5 my-2">
                <i class="bi bi-check-circle-fill display-3 text-success opacity-75 mb-2"></i>
                <h5 class="fw-bold mt-2 mb-1">Onay Bekleyen Rezervasyon Yok</h5>
                <p class="text-muted small col-md-6 mb-3">Şu anda onay veya ret işlemi bekleyen herhangi bir aktif rezervasyon talebi bulunmamaktadır.</p>
            </div>
        }
        else
        {
            <div class="scrollable-table-wrapper" style="max-height: 500px; overflow-y: auto;">
                <table class="table table-striped table-hover align-middle mb-0" style="width:100%">
                    <thead>
                        <tr>
                            <th>Personel</th>
                            <th>Kaynak</th>
                            <th>Başlangıç Tarihi</th>
                            <th>Bitiş Tarihi</th>
                            <th>Açıklama</th>
                            <th>Durum</th>
                            <th>Oluşturma Tarihi</th>
                            <th class="text-end" style="min-width: 180px;">İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            string personelTamAd = item.Personel != null ? $"{item.Personel.Ad} {item.Personel.Soyad}" : "Belirtilmedi";
                            <tr>
                                <td class="fw-semibold">
                                    <div class="d-flex align-items-center">
                                        <img src="https://ui-avatars.com/api/?name=@(System.Net.WebUtility.UrlEncode(personelTamAd))&background=random&color=fff&rounded=true&size=32" class="rounded-circle me-2" alt="Avatar" width="32" height="32" />
                                        <span>@personelTamAd</span>
                                    </div>
                                </td>
                                <td>
                                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-3 py-1 fw-bold">@(item.Kaynak != null ? item.Kaynak.Ad : "Belirtilmedi")</span>
                                </td>
                                <td>@item.BaslangicTarihi.ToString("dd.MM.yyyy HH:mm")</td>
                                <td>@item.BitisTarihi.ToString("dd.MM.yyyy HH:mm")</td>
                                <td>
                                    <small class="text-muted">@(string.IsNullOrEmpty(item.Aciklama) ? "-" : item.Aciklama)</small>
                                </td>
                                <td>
                                    <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle rounded-pill px-3 py-1 fw-bold">⏳ Beklemede</span>
                                </td>
                                <td>@item.OlusturmaTarihi.ToString("dd.MM.yyyy HH:mm")</td>
                                <td>
                                    <div class="d-flex gap-2 align-items-center">
                                        <form asp-controller="Rezervasyons" asp-action="Approve" asp-route-id="@item.Id" method="post" style="margin: 0;">
                                            <button type="submit" class="btn btn-sm shadow-sm" style="background-color: #198754; color: #ffffff; font-weight: 600; border: none; padding: 6px 12px; border-radius: 4px;">
                                                ✓ Onayla
                                            </button>
                                        </form>
                                        <form asp-controller="Rezervasyons" asp-action="Reject" asp-route-id="@item.Id" method="post" style="margin: 0;">
                                            <button type="submit" class="btn btn-sm shadow-sm" style="background-color: #dc3545; color: #ffffff; font-weight: 600; border: none; padding: 6px 12px; border-radius: 4px;">
                                                ✕ Reddet
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
